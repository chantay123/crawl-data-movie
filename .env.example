# =========================================
# Movie Crawler - Environment Configuration
# =========================================

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/movie-api

# Cấu hình crawl chung
TOTAL_PAGES=1500
PAGE_DELAY_MS=500
DETAIL_CONCURRENCY=5

# Nguồn crawl - Bật/tắt từng nguồn
ENABLE_OPHIM=true
ENABLE_KKPHIM=true
ENABLE_NGUONC=true

# URL các nguồn (chỉnh nếu API đổi domain)
OPHIM_BASE_URL=https://ophim1.com
KKPHIM_BASE_URL=https://kkphim.com
NGUONC_BASE_URL=https://nguonc.com

# JSON backup
JSON_BACKUP=true
JSON_OUTPUT_DIR=./data

# Logging
LOG_LEVEL=info

# REST API + Swagger UI (chạy bằng `npm run server`)
API_PORT=3000
