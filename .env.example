# =========================================
# Movie Crawler - Environment Configuration
# =========================================
# Shared Database với Backend MovieStreaming

# MongoDB - CHUNG DATABASE VỚI BACKEND
# Development (Local)
MONGODB_URI='mongodb://127.0.0.1:27017/movie-api'
MONGODB_NAME=movie-api

# Production (MongoDB Atlas - dùng chung với backend)
# MONGODB_URI='mongodb+srv://moviestreaming:Moviestreaming123@moviestreaming.7pxr5gw.mongodb.net/netflix-clone'
# MONGODB_NAME=netflix-clone

# Cấu hình Crawler
TOTAL_PAGES=3337
PAGE_DELAY_MS=1500
DETAIL_CONCURRENCY=5
MAX_EMPTY_PAGES=2

# Nguồn crawl - Bật/tắt từng nguồn
ENABLE_OPHIM=true
ENABLE_KKPHIM=true
ENABLE_NGUONC=true

# URL các nguồn (chỉnh nếu API đổi domain)
OPHIM_BASE_URL=https://ophim1.com/v1/api
KKPHIM_BASE_URL=https://kkphim.com/api
NGUONC_BASE_URL=https://phim.nguonc.com/api

# JSON backup (optional)
JSON_BACKUP=true
JSON_OUTPUT_DIR=./data

# Logging
LOG_LEVEL=info

# REST API + Swagger UI (chạy bằng `npm run server`)
API_PORT=3000

# TMDB API - For enriching movie data
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
ENABLE_TMDB_ENRICHMENT=true

# YouTube API - For trailer enrichment
YOUTUBE_API_KEY=your_youtube_api_key_here
ENABLE_YOUTUBE_ENRICHMENT=true

# YouTube HARDENED rate limiter / circuit breaker
YOUTUBE_CONCURRENCY=1
YOUTUBE_MAX_RETRIES=3
YOUTUBE_RETRY_BASE_DELAY_MS=30000
YOUTUBE_RETRY_MAX_DELAY_MS=3600000
YOUTUBE_CIRCUIT_FAILURE_THRESHOLD=3
YOUTUBE_CIRCUIT_COOLDOWN_MS=900000
YOUTUBE_REQUEST_TIMEOUT_MS=10000
YOUTUBE_RATE_LIMIT_MAX_RETRIES=1
YOUTUBE_MAX_QUERIES=4

# Trailer pipeline dedupe / lock (chống process trùng cùng 1 movie)
TRAILER_DEDUPE_WINDOW_MS=60000
TRAILER_LOCK_TIMEOUT_MS=120000
TRAILER_RATE_LIMIT_STREAK_LIMIT=5

# TMDB circuit breaker cho trailer (riêng khỏi YouTube)
TMDB_FAILURE_THRESHOLD=3
TMDB_CIRCUIT_COOLDOWN_MS=900000
TMDB_MAX_PAUSE_MS=3600000

# Wikidata API (không cần API key)
# CHÚ Ý: Wikidata anon rate limit ≈ 1 req/s. KHÔNG đặt WIKIDATA_REQUEST_DELAY dưới 1000.
ENABLE_WIKIDATA_ENRICHMENT=true
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
WIKIDATA_REQUEST_DELAY=1100
WIKIDATA_TIMEOUT_MS=10000
WIKIDATA_MAX_RETRIES=4
WIKIDATA_LANG=en
WIKIDATA_USER_AGENT=MovieStreaming/1.0 (https://github.com/your-repo; contact: your-email@example.com)
WIKIDATA_MIN_PAUSE_MS=60000
WIKIDATA_MAX_PAUSE_MS=600000
WIKIDATA_RETRY_DELAYS=30000,60000,120000,240000
WIKIDATA_CONCURRENCY=1
