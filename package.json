{
  "name": "movie-crawler",
  "version": "1.0.0",
  "description": "Standalone movie data crawler - tách từ MovieStreaming backend, crawl từ nhiều nguồn (OPhim, KKPhim, Nguonc) và lưu MongoDB + JSON backup. Kèm REST API + Swagger UI.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/index.js",
    "server": "node src/server.js",
    "dev": "node --watch src/server.js",
    "crawl:ophim": "node scripts/crawl-ophim.js",
    "crawl:ophim:all": "node scripts/crawl-ophim-all.js",
    "crawl:kkphim": "node scripts/crawl-kkphim.js",
    "crawl:nguonc": "node scripts/crawl-nguonc.js",
    "crawl:all": "node scripts/crawl-all.js",
    "crawl:standalone": "node scripts/crawl-standalone.js",
    "export:json": "node scripts/export-json.js",
    "test:endpoints": "node scripts/test-endpoints.js",
    "test:db": "node scripts/test-database-connection.js",
    "test:connection": "node scripts/test-connection-quick.js",
    "test:tmdb": "node scripts/test-tmdb.js",
    "test:tmdb-quick": "node scripts/test-tmdb-quick.js",
    "test:tmdb-fixed": "node scripts/test-tmdb-fixed.js",
    "test:enrichment": "node scripts/test-enrichment.js",
    "test:trailer": "node scripts/test-trailer-system.js",
    "test:trailer-quick": "node scripts/test-trailer-quick.js",
    "trailer:batch": "node scripts/batch-update-trailers.js",
    "migrate": "node scripts/migrate-to-normalized-schema.js",
    "cleanup:years": "node scripts/cleanup-years-in-categories.js",
    "quick-start": "node scripts/quick-start.js"
  },
  "keywords": [
    "crawler",
    "movie",
    "ophim",
    "kkphim",
    "nguonc",
    "mongodb",
    "swagger",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "mongoose": "^8.7.0",
    "p-limit": "^3.1.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
